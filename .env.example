# ChatBox distribution config — OPTIONAL. Leave everything blank for a normal build.
#
# Fill these in ONLY for a build you intend to hand to someone else. The values get bundled
# into the app and are EXTRACTABLE by anyone who has the app (app.asar can be unpacked).
# => Use a DEDICATED OpenRouter key with a low spending limit, and revoke it afterwards.
#
# Applied once, on the recipient's first launch (won't overwrite their later changes).

# --- Provider API keys ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# --- Default models (format: provider::model — the model id may contain "/") ---
# e.g. DEFAULT_MODEL=openrouter::anthropic/claude-sonnet-4.6
DEFAULT_MODEL=
DEFAULT_TITLE_MODEL=
